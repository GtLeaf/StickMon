# Apply before ESP-IDF loads sdkconfig, including cached build directories.
include_guard(GLOBAL)

if(STICKMON_ENABLE_DEBUG_FEATURES)
    set(_stickmon_optimization DEBUG)
    set(_stickmon_log_level INFO)
else()
    set(_stickmon_optimization SIZE)
    set(_stickmon_log_level WARN)
    set(STICKMON_HANG_DIAG OFF CACHE BOOL "Main-loop hang diagnostic" FORCE)
    set(STICKMON_ENABLE_ROOM_DIAGNOSTICS OFF CACHE BOOL "Room diagnostics" FORCE)
    set(STICKMON_ENABLE_TRACE_LOGS OFF CACHE BOOL "Trace logs" FORCE)
endif()

set(_stickmon_profile "")
foreach(_choice DEBUG SIZE PERF NONE)
    if(_choice STREQUAL _stickmon_optimization)
        string(APPEND _stickmon_profile "CONFIG_COMPILER_OPTIMIZATION_${_choice}=y\n")
    else()
        string(APPEND _stickmon_profile "# CONFIG_COMPILER_OPTIMIZATION_${_choice} is not set\n")
    endif()
endforeach()
foreach(_prefix LOG_DEFAULT_LEVEL BOOTLOADER_LOG_LEVEL)
    foreach(_choice NONE ERROR WARN INFO DEBUG VERBOSE)
        if(_choice STREQUAL _stickmon_log_level)
            string(APPEND _stickmon_profile "CONFIG_${_prefix}_${_choice}=y\n")
        else()
            string(APPEND _stickmon_profile "# CONFIG_${_prefix}_${_choice} is not set\n")
        endif()
    endforeach()
endforeach()

set(_stickmon_overlay "${CMAKE_BINARY_DIR}/sdkconfig.stickmon-profile")
file(WRITE "${_stickmon_overlay}" "${_stickmon_profile}")
if(NOT SDKCONFIG_DEFAULTS)
    set(SDKCONFIG_DEFAULTS "${CMAKE_SOURCE_DIR}/sdkconfig.defaults")
endif()
list(APPEND SDKCONFIG_DEFAULTS "${_stickmon_overlay}")

if(SDKCONFIG)
    get_filename_component(_stickmon_sdkconfig "${SDKCONFIG}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
else()
    set(_stickmon_sdkconfig "${CMAKE_SOURCE_DIR}/sdkconfig")
endif()
if(EXISTS "${_stickmon_sdkconfig}")
    file(READ "${_stickmon_sdkconfig}" _stickmon_cached)
    string(REPLACE "\n" ";" _stickmon_lines "${_stickmon_profile}")
    foreach(_line IN LISTS _stickmon_lines)
        if(_line MATCHES "^(# )?(CONFIG_[A-Z_]+)")
            set(_key "${CMAKE_MATCH_2}")
            # Leave unrelated board settings and recovery checks intact.
            string(REGEX REPLACE "(^|\n)(# ${_key} is not set|${_key}=[^\n]*)"
                   "\\1" _stickmon_cached "${_stickmon_cached}")
        endif()
    endforeach()
    # Append the choices as well, so an older config missing a symbol adopts it.
    string(APPEND _stickmon_cached "\n${_stickmon_profile}")
    file(WRITE "${_stickmon_sdkconfig}" "${_stickmon_cached}")
endif()
